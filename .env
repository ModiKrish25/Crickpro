# =============================================================================
# CrickPro - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.
# System environment variables take priority over values in this file.
# 
# Where to get these credentials (Freebuff/Manus platform):
#   - OAuth vars (VITE_APP_ID, OAUTH_SERVER_URL, etc.): Freebuff project dashboard
#   - Forge vars (BUILT_IN_*): Automatically injected when deployed on Freebuff
#   - DATABASE_URL: Your MySQL/TiDB connection string
#
# For local development without backend features, you only need:
 EXPO_PUBLIC_API_BASE_URL=http://localhost:3000 #=============================================================================

# --- Server Configuration ---

# MySQL/TiDB database connection string
# Format: mysql://username:password@host:3306/database_name
DATABASE_URL=mysql://root:Krish123@localhost:3306/crickpro

# Session signing secret (generate a random string, e.g. with: openssl rand -hex 32)
JWT_SECRET=134eff632cda9cd47fec76d39e298b36f73e96b86f699cfad80b7e3cf2ba56da

# Manus OAuth - App ID (from Freebuff project OAuth settings)
VITE_APP_ID=

# Manus OAuth - Backend server URL for token exchange
OAUTH_SERVER_URL=

# Manus OAuth - User-facing login portal URL
VITE_OAUTH_PORTAL_URL=

# Your (the owner's) unique Manus user ID
OWNER_OPEN_ID=

# Your display name
OWNER_NAME=

# Forge API - Built-in platform services (storage, LLM, image gen, etc.)
# These are automatically injected when deployed; needed for local dev
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Server port (default: 3000)
PORT=3000

# Node environment
NODE_ENV=development


# --- Frontend (Expo) Configuration ---
# These EXPO_PUBLIC_* vars are available in the browser.
# Most are auto-mapped from the server-side vars above by scripts/load-env.js.
# You only need to set these if you want to override the auto-mapped values.

# API server URL that the frontend calls (e.g., http://localhost:3000)
# If left empty, it auto-detects from the current hostname
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# OAuth portal URL (overrides auto-map from VITE_OAUTH_PORTAL_URL)
EXPO_PUBLIC_OAUTH_PORTAL_URL=

# OAuth server URL (overrides auto-map from OAUTH_SERVER_URL)
EXPO_PUBLIC_OAUTH_SERVER_URL=

# App ID (overrides auto-map from VITE_APP_ID)
EXPO_PUBLIC_APP_ID=

# Owner open ID (overrides auto-map from OWNER_OPEN_ID)
EXPO_PUBLIC_OWNER_OPEN_ID=

# Owner name (overrides auto-map from OWNER_NAME)
EXPO_PUBLIC_OWNER_NAME=
